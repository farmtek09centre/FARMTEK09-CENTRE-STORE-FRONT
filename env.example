# Safaricom Daraja sandbox credentials
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
MPESA_PASSKEY=YOUR_STK_PASSKEY

# Sandbox first; change to production only after approval/go-live
MPESA_ENV=sandbox

# The supplied Safaricom Postman collection uses 174379 as its STK sandbox shortcode.
# Replace this with the shortcode assigned to YOUR Daraja app when required.
MPESA_SHORTCODE=174379

# Public HTTPS URL of this backend. Safaricom must be able to reach the callback.
MPESA_CALLBACK_BASE_URL=https://YOUR-PUBLIC-HTTPS-BACKEND.example.com

# Website origin allowed to call this backend.
FRONTEND_ORIGIN=http://localhost:3000

PORT=3000
